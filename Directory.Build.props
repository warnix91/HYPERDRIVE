<Project>
  <!--
    Per-machine settings (KSP install path) live in KSP.props.user, which is gitignored.
    Copy KSP.props.user.example to KSP.props.user on each machine, or set the KSP_ROOT env var.
  -->
  <Import Project="$(MSBuildThisFileDirectory)KSP.props.user" Condition="Exists('$(MSBuildThisFileDirectory)KSP.props.user')" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <KSPRoot Condition="'$(KSPRoot)' == ''">$(KSP_ROOT)</KSPRoot>
    <KSPManaged Condition="'$(KSPManaged)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">$(KSPRoot)/KSP.app/Contents/Resources/Data/Managed</KSPManaged>
    <KSPManaged Condition="'$(KSPManaged)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">$(KSPRoot)\KSP_x64_Data\Managed</KSPManaged>
    <KSPManaged Condition="'$(KSPManaged)' == ''">$(KSPRoot)/KSP_Data/Managed</KSPManaged>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(KSPRoot)/GameData/000_Harmony/0Harmony.dll</HarmonyDll>
    <ModGameData>$(RepoRoot)GameData/Hyperdrive/</ModGameData>
    <DeployToKSP Condition="'$(DeployToKSP)' == ''">true</DeployToKSP>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Compile against the exact BCL that KSP ships (Unity Mono 4.x profile), not a desktop .NET Framework. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <FrameworkPathOverride>$(KSPManaged)</FrameworkPathOverride>
    <!-- No NuGet reference-assembly download: the game's own DLLs are the reference. -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <!-- No local path in the DLL or its PDB (stack traces show /Hyperdrive/src/...). -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/Hyperdrive/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>CS8600;CS0108;CS0114</WarningsAsErrors>
    <Version>1.0.1</Version>
    <Authors>warnix</Authors>
    <Product>Hyperdrive</Product>
  </PropertyGroup>

  <!-- Game assemblies: referenced, never copied (Private=false), never committed. -->
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(KSPManaged)/mscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System"><HintPath>$(KSPManaged)/System.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Core"><HintPath>$(KSPManaged)/System.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
